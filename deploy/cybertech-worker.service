[Unit]
Description=Cybertech demo background worker
After=network.target postgresql.service

[Service]
Type=simple
User=cybertech
Group=cybertech
WorkingDirectory=/srv/cybertech/current/backend
EnvironmentFile=/srv/cybertech/shared/demo.env
ExecStart=/srv/cybertech/current/backend/.venv/bin/python -m app.worker
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
